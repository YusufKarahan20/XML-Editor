/* ============================================================
   XML Analyzer — Professional Dark Theme
   resources/styles/dark_theme.qss

   Deep neutral dark palette with subtle slate grays.
   Accent: blue (#3b82f6) and gold (#d4af37) for highlights.
   ============================================================ */

/* ---------- Global ---------- */
* {
    font-family: "Segoe UI", "Inter", "Roboto", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #18181a;
    color: #e4e4e7;
}

QWidget {
    background-color: #18181a;
    color: #e4e4e7;
}

/* ---------- Menu Bar ---------- */
QMenuBar {
    background-color: #222226;
    color: #e4e4e7;
    border-bottom: 1px solid #333338;
    padding: 2px 0;
}

QMenuBar::item {
    padding: 5px 12px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #2e2e34;
}

QMenuBar::item:pressed {
    background-color: #383842;
}

QMenu {
    background-color: #222226;
    color: #e4e4e7;
    border: 1px solid #333338;
    border-radius: 4px;
    padding: 4px 0;
}

QMenu::item {
    padding: 6px 28px 6px 20px;
}

QMenu::item:selected {
    background-color: #2e2e34;
    color: #ffffff;
    border-radius: 3px;
}

QMenu::separator {
    height: 1px;
    background-color: #333338;
    margin: 4px 10px;
}

/* ---------- Toolbar ---------- */
QToolBar {
    background-color: #222226;
    border-bottom: 1px solid #333338;
    padding: 3px 6px;
    spacing: 4px;
}

QToolBar::separator {
    width: 1px;
    background-color: #333338;
    margin: 4px 6px;
}

QToolButton {
    background-color: transparent;
    color: #e4e4e7;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 5px 10px;
    font-size: 12px;
}

QToolButton:hover {
    background-color: #2d2d33;
    border-color: #3d3d46;
    color: #ffffff;
}

QToolButton:pressed {
    background-color: #37373f;
    color: #ffffff;
}

/* ---------- Splitter ---------- */
QSplitter::handle {
    background-color: #2e2e34;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #3b82f6;
}

/* ---------- Tree View (general — XML Tree panel) ---------- */
QTreeView {
    background-color: #1e1e22;
    color: #e4e4e7;
    border: 1px solid #333338;
    border-radius: 4px;
    padding: 2px;
    outline: 0;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QTreeView::item {
    padding: 3px 2px;
}

QTreeView::item:hover {
    background-color: #28282e;
}

QTreeView::item:selected {
    background-color: #264f78;
    color: #ffffff;
}

/* ---------- XML Grid (objectName: xmlGridView) ---------- */
QTreeView#xmlGridView {
    background-color: #1e1e22;
    alternate-background-color: #242428;
    color: #e4e4e7;
    border: 1px solid #333338;
    border-radius: 4px;
    padding: 0;
    outline: 0;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QTreeView#xmlGridView::item {
    padding: 4px 8px;
    border-bottom: 1px solid #2e2e34;
    border-right: 1px solid #2e2e34;
}

QTreeView#xmlGridView::item:hover {
    background-color: #28282e;
}

QTreeView#xmlGridView::item:selected {
    background-color: #264f78;
    color: #ffffff;
}

/* ---------- Header View ---------- */
QHeaderView::section {
    background-color: #26262b;
    color: #a0a0a8;
    border: none;
    border-bottom: 2px solid #333338;
    border-right: 1px solid #333338;
    padding: 6px 10px;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QHeaderView::section:last {
    border-right: none;
}

/* ---------- Table View (kept for any future flat tables) ---------- */
QTableView {
    background-color: #1e1e22;
    color: #e4e4e7;
    border: 1px solid #333338;
    border-radius: 4px;
    padding: 0;
    gridline-color: #2e2e34;
    outline: 0;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QTableView::item {
    padding: 4px 8px;
}

QTableView::item:hover {
    background-color: #28282e;
}

QTableView::item:selected {
    background-color: #264f78;
    color: #ffffff;
}

/* ---------- Text Edit / JSON Preview ---------- */
QPlainTextEdit, QTextEdit {
    background-color: #1e1e22;
    color: #e4e4e7;
    border: 1px solid #333338;
    border-radius: 4px;
    padding: 8px;
    font-family: "Cascadia Code", "JetBrains Mono", "Consolas", monospace;
    font-size: 13px;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

/* ---------- Line Edit (Search) ---------- */
QLineEdit {
    background-color: #18181a;
    color: #e4e4e7;
    border: 1px solid #3d3d44;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 13px;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border-color: #3b82f6;
}

QLineEdit::placeholder {
    color: #6c6c74;
}

/* ---------- Combo Box (Filter Explorer & General) ---------- */
QComboBox {
    background-color: #1e1e22;
    color: #e4e4e7;
    border: 1px solid #3d3d44;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}

QComboBox:hover {
    border-color: #555560;
}

QComboBox:focus {
    border-color: #3b82f6;
}

QComboBox:disabled {
    background-color: #242428;
    color: #606068;
    border-color: #333338;
}

/* ---------- Combo Box Dropdown Popup ---------- */
QComboBox QAbstractItemView {
    background-color: #222226;
    color: #e4e4e7;
    border: 1px solid #333338;
    border-radius: 4px;
    selection-background-color: #264f78;
    selection-color: #ffffff;
    outline: 0;
    padding: 1px;
}

QComboBox QAbstractItemView::item {
    background-color: #222226;
    color: #e4e4e7;
    min-height: 24px;
    padding: 3px 6px;
    border-radius: 2px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #2e2e34;
    color: #ffffff;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #264f78;
    color: #ffffff;
}

/* ---------- Push Buttons ---------- */
QPushButton {
    background-color: #2a2a30;
    color: #e4e4e7;
    border: 1px solid #3d3d46;
    border-radius: 4px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #33333b;
    border-color: #4f4f5a;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #3d3d47;
}

QPushButton:disabled {
    background-color: #222226;
    color: #606068;
    border-color: #333338;
}

/* ---------- Status Bar ---------- */
QStatusBar {
    background-color: #222226;
    color: #a0a0a8;
    border-top: 1px solid #333338;
    font-size: 12px;
    padding: 2px 8px;
}

QStatusBar QLabel {
    color: #a0a0a8;
    padding: 0 8px;
    background-color: transparent;
}

/* ---------- Panel Header Labels (objectName: panelHeader) ---------- */
QLabel#panelHeader {
    font-size: 11px;
    font-weight: 700;
    color: #a0a0a8;
    letter-spacing: 1px;
    padding: 4px 2px;
    background: transparent;
}

/* ---------- Group Box ---------- */
QGroupBox {
    background-color: #18181a;
    border: 1px solid #333338;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 2px 8px;
    color: #a0a0a8;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ---------- Scroll Bar ---------- */
QScrollBar:vertical {
    background-color: #18181a;
    width: 10px;
    margin: 0;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #383840;
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4a4a54;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #18181a;
    height: 10px;
    margin: 0;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #383840;
    min-width: 30px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4a4a54;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- Tab Widget ---------- */
QTabWidget::pane {
    border: 1px solid #333338;
    border-radius: 4px;
    background-color: #18181a;
}

QTabBar::tab {
    background-color: #26262b;
    color: #909098;
    border: 1px solid #333338;
    border-bottom: none;
    padding: 6px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #18181a;
    color: #ffffff;
}

QTabBar::tab:hover:!selected {
    background-color: #303036;
    color: #ffffff;
}

/* ---------- Tooltip ---------- */
QToolTip {
    background-color: #25252a;
    color: #ffffff;
    border: 1px solid #404048;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ---------- Validation Bar (Error Alert) ---------- */
QFrame#validationBar {
    background-color: #341818;
    border-top: 1px solid #5c2424;
    border-bottom: 1px solid #5c2424;
    padding: 0 4px;
}
QLabel#badge {
    background-color: #ef4444;
    color: #ffffff;
    font-weight: bold;
    border-radius: 3px;
    padding: 2px 6px;
}
QLabel#location {
    color: #fca5a5;
    font-weight: bold;
    padding-left: 4px;
}
QLabel#msg {
    color: #fca5a5;
    padding-left: 4px;
}
QPushButton.jumpBtn {
    background-color: #2a1616;
    color: #fca5a5;
    border: 1px solid #ef4444;
    border-radius: 3px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton.jumpBtn:hover {
    background-color: #421c1c;
}
QPushButton.jumpBtn:pressed {
    background-color: #552424;
}

